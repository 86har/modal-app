{
  "manifest_version": 3,
  "name": "deepL Prompter",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "content_scripts": [
    {
      "matches": ["https://www.deepl.com/*/translator*"],
      "js": ["content.js"],
      "css": ["style/content.css"],
      "run_at": "document_idle"
    }
  ]
}